# =============================================================================
# Node v0.12.0 — Personal WebOS, Multi-LMS & Server AI Hub
# Copy to `.env` (or paste into Dockge's .env panel) before `docker compose up -d`.
# =============================================================================

# Bind Dashboard to 0.0.0.0, 127.0.0.1 (Cloudflare Tunnel), or your Tailscale IP
BIND_IP=0.0.0.0
DASHBOARD_PORT=8080

# Localhost-only FastAPI port on the host
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8000

# =============================================================================
# Server-Only OS Lock Screen Authentication (Zero-Leak Public Cloudflare Ready)
# Credentials can NEVER be changed from the browser — only via `.env` here or
# via SSH: `docker exec -it hub-backend python -m app.auth_cli set <username>`
# =============================================================================
NODE_AUTH_ENABLED=true
NODE_AUTH_USERNAME=admin
NODE_AUTH_PASSWORD=changeme
# Optional pre-hashed PBKDF2-HMAC-SHA256 string (`python -m app.auth_cli hash`):
NODE_AUTH_PASSWORD_HASH=
NODE_AUTH_SESSION_DAYS=7

# Local Timezone (authoritative for 14-day Calendar Lookup Table & Cron)
TZ=America/New_York

# Optional: Mount host /var/run/tailscale so Node queries tailscaled LocalAPI directly
TAILSCALE_SOCK_DIR=/var/run/tailscale

# =============================================================================
# Multi-Provider AI (Local Ollama, Remote Ollama, & Cloud API Keys)
# Additional remote Ollama servers & Cloud keys can also be configured live in
# Settings -> AI Models & API Keys, or registered via POST /api/v1/models/ping.
# =============================================================================
# One Ollama serves both of Node's models, picked by name per request:
#   CHAT_MODEL     -> /api/chat      chat, tools, briefings (e.g. your LFM3 chat tag)
#   DECISION_MODEL -> /v1/systemone  Inbox tagging, priority, tool routing (`ollama pull d1`)
# Leave either on auto to pick from what Ollama has installed.
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=
DECISION_MODEL=auto
# Optional: point the decision model at a separate System One server instead
# (llama.cpp `llama serve`, or https://api.liquid.ai/decisions + DECISION_API_KEY).
DECISION_BASE_URL=
DECISION_API_KEY=
# Covers Ollama cold-loading d1 on the first request. Tip: set
# OLLAMA_KEEP_ALIVE=-1 on the Ollama server so both models stay loaded.
DECISION_TIMEOUT_SECONDS=12
OLLAMA_NUM_THREADS=4
OLLAMA_NUM_CTX=4096
OLLAMA_ENABLE_THINKING=true
OLLAMA_TIMEOUT_SECONDS=180

# Optional Cloud Model Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional Self-Hosted SearXNG JSON URL (defaults to built-in DuckDuckGo/Wiki search)
SEARXNG_URL=

# Synthetic demo seeding disabled — fresh installations start completely clean
SEED_DEMO_DATA=false
